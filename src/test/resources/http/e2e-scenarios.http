###

### =================================================
### 부하 테스트 결과 요약
### =================================================

### 최종 결과 확인
GET {{host}}/api/orders/summary

> {%
    console.log("=== 부하 테스트 결과 요약 ===");
    console.log("전체 테스트 완료 시간: " + new Date().toISOString());

    // 각 사용자별 주문 결과 확인
    const orderIds = ["orderId1", "orderId2", "orderId3", "orderId4", "orderId5"];
    orderIds.forEach((orderIdVar, index) => {
        const orderId = client.global.get(orderIdVar);
        const userNum = index + 1;
        if (orderId && orderId !== "failed") {
            console.log("사용자" + userNum + " 주문 성공 - ID: " + orderId);
        } else {
            console.log("사용자" + userNum + " 주문 실패");
        }
    });
%}

